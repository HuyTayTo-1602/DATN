# =============================================================================
# .env.example
# File mẫu cấu hình môi trường. SAO CHÉP file này thành .env và điền giá trị thực.
# KHÔNG commit file .env vào git (đã được thêm vào .gitignore).
# =============================================================================

# --- Kết nối PostgreSQL ---
# Định dạng: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://postgres:password@localhost:5432/job_recruitment

# --- JWT Secret Key ---
# Dùng để ký JWT token. Thay bằng chuỗi ngẫu nhiên dài trong production.
# Tạo bằng: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Cấu hình ứng dụng ---
APP_NAME=Job Recruitment API
DEBUG=True
API_PREFIX=/api/v1

# --- CORS: địa chỉ frontend được phép gọi API ---
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- LLM API (Chatbot) ---
# Điền API key của dịch vụ LLM bạn dùng (OpenAI, Google Gemini, ...)
LLM_API_KEY=your-llm-api-key-here
LLM_MODEL=gpt-4o-mini
